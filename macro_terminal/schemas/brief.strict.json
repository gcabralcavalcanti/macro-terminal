{
  "$comment": "Local validation, stricter than what the API enforces (structured outputs ignore lengths and item counts).",
  "type": "object",
  "properties": {
    "headline": {"type": "string", "minLength": 10, "maxLength": 140},
    "points": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 15, "maxLength": 320}},
    "risks": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 10, "maxLength": 240}},
    "data_caveats": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 240}}
  },
  "required": ["headline", "points", "risks", "data_caveats"],
  "additionalProperties": false
}
